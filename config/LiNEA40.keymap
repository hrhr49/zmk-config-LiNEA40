#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

&mt {
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    flavor = "balanced";
    hold-trigger-on-release;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転,,,,,,,,,,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        DeleteKey {
            bindings = <&kp DEL>;
            key-positions = <7 8>;
        };

        InsertKey {
            bindings = <&kp INS>;
            key-positions = <6 7>;
        };

        CenterClick {
            bindings = <&mkp MB3>;
            key-positions = <17 16>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <18 17>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <27 28>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <26 27>;
        };

        RBootloader {
            bindings = <&bootloader>;
            key-positions = <5 6>;
        };

        KC_LANG2 {
            bindings = <&kp LANG_HANJA>;
            key-positions = <11 12>;
        };

        KC_LANG1 {
            bindings = <&kp LANG_HANGEUL>;
            key-positions = <12 13>;
        };

        CtrlTab {
            bindings = <&kp LC(TAB)>;
            key-positions = <22 23>;
        };

        ShiftCtrlTab {
            bindings = <&kp LC(LS(TAB))>;
            key-positions = <21 22>;
        };

        KC_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        kC_TAB {
            bindings = <&kp TAB>;
            key-positions = <1 2>;
        };

        CmdAtmark {
            bindings = <&kp LG(LEFT_BRACKET)>;
            key-positions = <2 3>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W               &kp E         &kp R    &kp T                                              &kp Y        &kp U  &kp I                &kp O            &kp P
&mt LCTRL A       &mt LCTRL S         &kp D         &kp F    &kp G                                              &kp H        &kp J  &kp K                &lt 6 L          &lt 5 MINUS
&mt LEFT_SHIFT Z  &mt LEFT_SHIFT X    &kp C         &kp V    &kp B                                              &kp N        &kp M  &kp COMMA            &kp DOT          &mt RIGHT_SHIFT ENTER
&mt LCTRL ESC     &mt LEFT_ALT GRAVE  &kp LEFT_WIN  &kp INS  &lt 6 LANG_HANJA  &lt 2 LANG_HANGEUL    &lt 2 TAB  &lt 3 SPACE         &lt 4 RIGHT_BRACKET  &lt 7 BACKSLASH  &mt RIGHT_SHIFT SLASH
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans  &trans  &trans
            >;
        };

        MARK {
            bindings = <
&kp EXCLAMATION  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT                    &kp CARET         &kp AMPERSAND  &kp ASTERISK           &kp LEFT_PARENTHESIS  &kp EQUAL
&trans           &trans  &trans    &trans      &trans                         &kp SEMICOLON     &kp LS(LBKT)   &kp RIGHT_BRACKET      &kp BACKSLASH         &kp LBKT
&trans           &trans  &trans    &trans      &trans                         &kp SINGLE_QUOTE  &kp INT3       &kp LS(RIGHT_BRACKET)  &kp LS(BACKSLASH)     &kp LS(INT1)
&trans           &trans  &trans    &trans      &trans       &trans    &trans  &trans                           &kp ASTERISK           &kp LEFT_PARENTHESIS  &kp LS(QUESTION)
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        NUMBER {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &kp KP_DIVIDE  &kp N7        &kp N8        &kp N9        &kp KP_MULTIPLY
&trans  &trans  &trans  &trans  &trans                    &kp N0         &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp KP_MINUS
&trans  &trans  &trans  &trans  &trans                    &kp N0         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_PLUS
&trans  &trans  &trans  &trans  &trans  &trans    &kp N0  &kp N0                       &kp KP_DOT    &kp KP_EQUAL  &kp KP_ENTER
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
        };

        FUNCTION {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5                     &trans  &trans    &kp PAGE_UP    &trans   &trans
&kp F6  &kp F7  &kp F8  &kp F9   &kp F10                    &trans  &kp HOME  &kp PAGE_DOWN  &kp END  &trans
&trans  &trans  &trans  &kp F11  &kp F12                    &trans  &trans    &trans         &trans   &trans
&trans  &trans  &trans  &trans   &trans   &trans    &trans  &trans            &trans         &trans   &trans
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        CURSOR {
            bindings = <
&kp ESCAPE  &trans  &trans      &trans  &trans                    &trans         &trans          &kp UP_ARROW    &trans     &trans
&trans      &trans  &kp DELETE  &trans  &trans                    &kp BACKSPACE  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &trans
&trans      &trans  &trans      &trans  &trans                    &trans         &trans          &trans          &trans     &trans
&trans      &trans  &trans      &trans  &trans  &trans    &trans  &trans                         &trans          &trans     &trans
            >;
        };

        CLICK {
            bindings = <
&trans  &trans          &msc SCRL_UP    &trans           &trans                    &trans    &trans    &trans    &trans  &trans
&trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans                    &mkp MB3  &mkp MB1  &mkp MB2  &trans  &trans
&trans  &trans          &trans          &trans           &trans                    &trans    &mkp MB4  &mkp MB5  &trans  &trans
&trans  &trans          &trans          &trans           &trans  &trans    &trans  &trans              &trans    &trans  &trans
            >;
        };

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock                &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };
    };
};
